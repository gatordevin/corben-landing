{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/api",
      "destination": "/api.html"
    },
    {
      "source": "/((?!assets|.*\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
