{
  "version": 2,
  "name": "corben-agent-landing",
  "builds": [
    {
      "src": "subdomain-router.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "api.html",
          "app.html",
          "blog.html"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/subdomain-router.js"
    }
  ],
  "functions": {
    "subdomain-router.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/api",
      "destination": "/api.html"
    }
  ]
}